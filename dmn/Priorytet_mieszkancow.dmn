<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="Priorytet_mieszkancow_defs" name="Priorytet mieszkańców" namespace="http://camunda.org/schema/1.0/dmn">
<decision id="Priorytet_mieszkancow" name="Priorytet"><decisionTable id="DT_217" hitPolicy="FIRST"><input id="In_218" label="status"><inputExpression id="IX_219" typeRef="string"><text>status</text></inputExpression></input><input id="In_220" label="wiek"><inputExpression id="IX_221" typeRef="number"><text>wiek</text></inputExpression></input><input id="In_222" label="stanZdrowia"><inputExpression id="IX_223" typeRef="string"><text>stanZdrowia</text></inputExpression></input><input id="In_224" label="chorobyPrzewlekle"><inputExpression id="IX_225" typeRef="boolean"><text>chorobyPrzewlekle</text></inputExpression></input><input id="In_226" label="niepelnosprawnosc"><inputExpression id="IX_227" typeRef="string"><text>niepelnosprawnosc</text></inputExpression></input><input id="In_228" label="utrataMieszkania"><inputExpression id="IX_229" typeRef="boolean"><text>utrataMieszkania</text></inputExpression></input><input id="In_230" label="zawodKrytyczny"><inputExpression id="IX_231" typeRef="boolean"><text>zawodKrytyczny</text></inputExpression></input><input id="In_232" label="osobyNaUtrzymaniu"><inputExpression id="IX_233" typeRef="number"><text>osobyNaUtrzymaniu</text></inputExpression></input><output id="Out_234" label="priorytet" name="priorytet" typeRef="string"/><output id="Out_235" label="poziomPotrzeb" name="poziomPotrzeb" typeRef="string"/><output id="Out_236" label="dostawaBezposrednia" name="dostawaBezposrednia" typeRef="boolean"/><rule id="R_1"><description>1. Osoba nie żyje lub zaginęła – wykluczona z przydziału</description><inputEntry id="IE_2"><text>not("ZYJE")</text></inputEntry><inputEntry id="IE_3"><text>-</text></inputEntry><inputEntry id="IE_4"><text>-</text></inputEntry><inputEntry id="IE_5"><text>-</text></inputEntry><inputEntry id="IE_6"><text>-</text></inputEntry><inputEntry id="IE_7"><text>-</text></inputEntry><inputEntry id="IE_8"><text>-</text></inputEntry><inputEntry id="IE_9"><text>-</text></inputEntry><outputEntry id="OE_10"><text>"WYKLUCZONY"</text></outputEntry><outputEntry id="OE_11"><text>"PODSTAWOWY"</text></outputEntry><outputEntry id="OE_12"><text>false</text></outputEntry></rule><rule id="R_13"><description>2a. Ciężki stan zdrowia</description><inputEntry id="IE_14"><text>-</text></inputEntry><inputEntry id="IE_15"><text>-</text></inputEntry><inputEntry id="IE_16"><text>"CIEZKI"</text></inputEntry><inputEntry id="IE_17"><text>-</text></inputEntry><inputEntry id="IE_18"><text>-</text></inputEntry><inputEntry id="IE_19"><text>-</text></inputEntry><inputEntry id="IE_20"><text>-</text></inputEntry><inputEntry id="IE_21"><text>-</text></inputEntry><outputEntry id="OE_22"><text>"A"</text></outputEntry><outputEntry id="OE_23"><text>"KRYTYCZNY"</text></outputEntry><outputEntry id="OE_24"><text>true</text></outputEntry></rule><rule id="R_25"><description>2b. Znaczna niepełnosprawność</description><inputEntry id="IE_26"><text>-</text></inputEntry><inputEntry id="IE_27"><text>-</text></inputEntry><inputEntry id="IE_28"><text>-</text></inputEntry><inputEntry id="IE_29"><text>-</text></inputEntry><inputEntry id="IE_30"><text>"ZNACZNY"</text></inputEntry><inputEntry id="IE_31"><text>-</text></inputEntry><inputEntry id="IE_32"><text>-</text></inputEntry><inputEntry id="IE_33"><text>-</text></inputEntry><outputEntry id="OE_34"><text>"A"</text></outputEntry><outputEntry id="OE_35"><text>"KRYTYCZNY"</text></outputEntry><outputEntry id="OE_36"><text>true</text></outputEntry></rule><rule id="R_37"><description>3a. Małe dziecko</description><inputEntry id="IE_38"><text>-</text></inputEntry><inputEntry id="IE_39"><text>&lt; 3</text></inputEntry><inputEntry id="IE_40"><text>-</text></inputEntry><inputEntry id="IE_41"><text>-</text></inputEntry><inputEntry id="IE_42"><text>-</text></inputEntry><inputEntry id="IE_43"><text>-</text></inputEntry><inputEntry id="IE_44"><text>-</text></inputEntry><inputEntry id="IE_45"><text>-</text></inputEntry><outputEntry id="OE_46"><text>"A"</text></outputEntry><outputEntry id="OE_47"><text>"PODWYZSZONY"</text></outputEntry><outputEntry id="OE_48"><text>false</text></outputEntry></rule><rule id="R_49"><description>3b. Senior 75+ – dostawa bezpośrednia</description><inputEntry id="IE_50"><text>-</text></inputEntry><inputEntry id="IE_51"><text>&gt;= 75</text></inputEntry><inputEntry id="IE_52"><text>-</text></inputEntry><inputEntry id="IE_53"><text>-</text></inputEntry><inputEntry id="IE_54"><text>-</text></inputEntry><inputEntry id="IE_55"><text>-</text></inputEntry><inputEntry id="IE_56"><text>-</text></inputEntry><inputEntry id="IE_57"><text>-</text></inputEntry><outputEntry id="OE_58"><text>"A"</text></outputEntry><outputEntry id="OE_59"><text>"PODWYZSZONY"</text></outputEntry><outputEntry id="OE_60"><text>true</text></outputEntry></rule><rule id="R_61"><description>4. Utrata mieszkania</description><inputEntry id="IE_62"><text>-</text></inputEntry><inputEntry id="IE_63"><text>-</text></inputEntry><inputEntry id="IE_64"><text>-</text></inputEntry><inputEntry id="IE_65"><text>-</text></inputEntry><inputEntry id="IE_66"><text>-</text></inputEntry><inputEntry id="IE_67"><text>true</text></inputEntry><inputEntry id="IE_68"><text>-</text></inputEntry><inputEntry id="IE_69"><text>-</text></inputEntry><outputEntry id="OE_70"><text>"A"</text></outputEntry><outputEntry id="OE_71"><text>"PODWYZSZONY"</text></outputEntry><outputEntry id="OE_72"><text>false</text></outputEntry></rule><rule id="R_73"><description>5a. Choroba</description><inputEntry id="IE_74"><text>-</text></inputEntry><inputEntry id="IE_75"><text>-</text></inputEntry><inputEntry id="IE_76"><text>"CHOROBA"</text></inputEntry><inputEntry id="IE_77"><text>-</text></inputEntry><inputEntry id="IE_78"><text>-</text></inputEntry><inputEntry id="IE_79"><text>-</text></inputEntry><inputEntry id="IE_80"><text>-</text></inputEntry><inputEntry id="IE_81"><text>-</text></inputEntry><outputEntry id="OE_82"><text>"B"</text></outputEntry><outputEntry id="OE_83"><text>"PODWYZSZONY"</text></outputEntry><outputEntry id="OE_84"><text>false</text></outputEntry></rule><rule id="R_85"><description>5b. Choroby przewlekłe</description><inputEntry id="IE_86"><text>-</text></inputEntry><inputEntry id="IE_87"><text>-</text></inputEntry><inputEntry id="IE_88"><text>-</text></inputEntry><inputEntry id="IE_89"><text>true</text></inputEntry><inputEntry id="IE_90"><text>-</text></inputEntry><inputEntry id="IE_91"><text>-</text></inputEntry><inputEntry id="IE_92"><text>-</text></inputEntry><inputEntry id="IE_93"><text>-</text></inputEntry><outputEntry id="OE_94"><text>"B"</text></outputEntry><outputEntry id="OE_95"><text>"PODWYZSZONY"</text></outputEntry><outputEntry id="OE_96"><text>false</text></outputEntry></rule><rule id="R_97"><description>5c. Umiarkowana niepełnosprawność</description><inputEntry id="IE_98"><text>-</text></inputEntry><inputEntry id="IE_99"><text>-</text></inputEntry><inputEntry id="IE_100"><text>-</text></inputEntry><inputEntry id="IE_101"><text>-</text></inputEntry><inputEntry id="IE_102"><text>"UMIARKOWANY"</text></inputEntry><inputEntry id="IE_103"><text>-</text></inputEntry><inputEntry id="IE_104"><text>-</text></inputEntry><inputEntry id="IE_105"><text>-</text></inputEntry><outputEntry id="OE_106"><text>"B"</text></outputEntry><outputEntry id="OE_107"><text>"PODWYZSZONY"</text></outputEntry><outputEntry id="OE_108"><text>false</text></outputEntry></rule><rule id="R_109"><description>6a. Zawód krytyczny</description><inputEntry id="IE_110"><text>-</text></inputEntry><inputEntry id="IE_111"><text>-</text></inputEntry><inputEntry id="IE_112"><text>-</text></inputEntry><inputEntry id="IE_113"><text>-</text></inputEntry><inputEntry id="IE_114"><text>-</text></inputEntry><inputEntry id="IE_115"><text>-</text></inputEntry><inputEntry id="IE_116"><text>true</text></inputEntry><inputEntry id="IE_117"><text>-</text></inputEntry><outputEntry id="OE_118"><text>"B"</text></outputEntry><outputEntry id="OE_119"><text>"PODSTAWOWY"</text></outputEntry><outputEntry id="OE_120"><text>false</text></outputEntry></rule><rule id="R_121"><description>6b. Co najmniej 2 osoby na utrzymaniu</description><inputEntry id="IE_122"><text>-</text></inputEntry><inputEntry id="IE_123"><text>-</text></inputEntry><inputEntry id="IE_124"><text>-</text></inputEntry><inputEntry id="IE_125"><text>-</text></inputEntry><inputEntry id="IE_126"><text>-</text></inputEntry><inputEntry id="IE_127"><text>-</text></inputEntry><inputEntry id="IE_128"><text>-</text></inputEntry><inputEntry id="IE_129"><text>&gt;= 2</text></inputEntry><outputEntry id="OE_130"><text>"B"</text></outputEntry><outputEntry id="OE_131"><text>"PODSTAWOWY"</text></outputEntry><outputEntry id="OE_132"><text>false</text></outputEntry></rule><rule id="R_133"><description>7. Pozostali</description><inputEntry id="IE_134"><text>-</text></inputEntry><inputEntry id="IE_135"><text>-</text></inputEntry><inputEntry id="IE_136"><text>-</text></inputEntry><inputEntry id="IE_137"><text>-</text></inputEntry><inputEntry id="IE_138"><text>-</text></inputEntry><inputEntry id="IE_139"><text>-</text></inputEntry><inputEntry id="IE_140"><text>-</text></inputEntry><inputEntry id="IE_141"><text>-</text></inputEntry><outputEntry id="OE_142"><text>"C"</text></outputEntry><outputEntry id="OE_143"><text>"PODSTAWOWY"</text></outputEntry><outputEntry id="OE_144"><text>false</text></outputEntry></rule></decisionTable></decision>
<decision id="Normy_dzienne" name="Normy dzienne"><decisionTable id="DT_237" hitPolicy="UNIQUE"><input id="In_238" label="poziomPotrzeb"><inputExpression id="IX_239" typeRef="string"><text>poziomPotrzeb</text></inputExpression></input><input id="In_240" label="grupaWiekowa"><inputExpression id="IX_241" typeRef="string"><text>grupaWiekowa</text></inputExpression></input><output id="Out_242" label="wodaL" name="wodaL" typeRef="number"/><output id="Out_243" label="zywnoscKg" name="zywnoscKg" typeRef="number"/><output id="Out_244" label="lekiZestaw" name="lekiZestaw" typeRef="number"/><output id="Out_245" label="higienaZestaw" name="higienaZestaw" typeRef="number"/><output id="Out_246" label="schronienie" name="schronienie" typeRef="number"/><rule id="R_145"><inputEntry id="IE_146"><text>"PODSTAWOWY"</text></inputEntry><inputEntry id="IE_147"><text>"DZIECKO"</text></inputEntry><outputEntry id="OE_148"><text>2</text></outputEntry><outputEntry id="OE_149"><text>0.4</text></outputEntry><outputEntry id="OE_150"><text>0</text></outputEntry><outputEntry id="OE_151"><text>0.1</text></outputEntry><outputEntry id="OE_152"><text>0</text></outputEntry></rule><rule id="R_153"><inputEntry id="IE_154"><text>"PODSTAWOWY"</text></inputEntry><inputEntry id="IE_155"><text>"DOROSLY"</text></inputEntry><outputEntry id="OE_156"><text>3</text></outputEntry><outputEntry id="OE_157"><text>0.6</text></outputEntry><outputEntry id="OE_158"><text>0</text></outputEntry><outputEntry id="OE_159"><text>0.1</text></outputEntry><outputEntry id="OE_160"><text>0</text></outputEntry></rule><rule id="R_161"><inputEntry id="IE_162"><text>"PODSTAWOWY"</text></inputEntry><inputEntry id="IE_163"><text>"SENIOR"</text></inputEntry><outputEntry id="OE_164"><text>3</text></outputEntry><outputEntry id="OE_165"><text>0.5</text></outputEntry><outputEntry id="OE_166"><text>0</text></outputEntry><outputEntry id="OE_167"><text>0.1</text></outputEntry><outputEntry id="OE_168"><text>0</text></outputEntry></rule><rule id="R