# Skopiuj ten plik do .env i uzupełnij wartości. Plik .env NIE trafia do repozytorium.

# --- PostgreSQL ---
POSTGRES_DB=ipbisr
POSTGRES_USER=ipbisr
POSTGRES_PASSWORD=zmien_mnie
POSTGRES_PORT=5432

# --- Porty serwisów ---
BACKEND_PORT=8081
ML_SERVICE_PORT=8000

# --- Adresy serwisów (dla uruchomienia lokalnego, bez Dockera) ---
ML_SERVICE_URL=http://localhost:8000
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ipbisr
SPRING_DATASOURCE_USERNAME=ipbisr
SPRING_DATASOURCE_PASSWORD=zmien_mnie

# --- Frontend (Next.js, odczyt po stronie serwera) ---
BACKEND_URL=http://localhost:8081

# --- Camunda 8 ---
# Wariant A: lokalnie Camunda 8 Run (bez uwierzytelniania)
CAMUNDA_CLIENT_MODE=self-managed
CAMUNDA_CLIENT_GRPC_ADDRESS=http://localhost:26500
CAMUNDA_CLIENT_REST_ADDRESS=http://localhost:8080
# Wariant B: serwer uczelniany / SaaS – wpisz dane od prowadzącego (NIGDY nie commituj!)
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
CAMUNDA_CLUSTER_ID=
CAMUNDA_CLIENT_REGION=
