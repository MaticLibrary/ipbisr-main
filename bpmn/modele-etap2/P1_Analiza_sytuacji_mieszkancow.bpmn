<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="P1v4_defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
<bpmn:collaboration id="P1_collab">
<bpmn:participant id="Pool_REJ" name="Rejestr ludności" processRef="P_Rejestr" />
<bpmn:participant id="Pool_CK" name="Centrum kryzysowe – Analiza sytuacji mieszkańców" processRef="P1_Analiza" />
<bpmn:participant id="Pool_OP" name="Punkt wydawania – Operator" processRef="P1_Zgloszenie" />
<bpmn:messageFlow id="MF1" name="Zapytanie o dane" sourceRef="T1" targetRef="R_S" />
<bpmn:messageFlow id="MF2" name="Dane mieszkańców" sourceRef="R_E" targetRef="T2" />
<bpmn:messageFlow id="MF3" name="Zgłoszenie zdarzenia" sourceRef="T7" targetRef="S3" />
<bpmn:textAnnotation id="Note1"><bpmn:text>Przekazanie zgłoszenia jest asynchroniczne – operator nie czeka na wynik analizy.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As1" sourceRef="T7" targetRef="Note1" />
</bpmn:collaboration>
<bpmn:process id="P_Rejestr" name="Rejestr ludności – udostępnianie danych" isExecutable="false">
<bpmn:startEvent id="R_S" name="Otrzymano zapytanie o dane"><bpmn:messageEventDefinition id="R_S_m" messageRef="Msg_Zap" /></bpmn:startEvent>
<bpmn:serviceTask id="R_T1" name="Odczytaj dane mieszkańców z ewidencji"><bpmn:property id="R_T1_p" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="R_DIA"><bpmn:sourceRef>R_DS</bpmn:sourceRef><bpmn:targetRef>R_T1_p</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="R_E" name="Dane wysłane"><bpmn:messageEventDefinition id="R_E_m" /></bpmn:endEvent>
<bpmn:dataStoreReference id="R_DS" name="Ewidencja ludności" />
<bpmn:sequenceFlow id="R_F1" sourceRef="R_S" targetRef="R_T1" />
<bpmn:sequenceFlow id="R_F2" sourceRef="R_T1" targetRef="R_E" />
</bpmn:process>
<bpmn:process id="P1_Analiza" name="P1 – Analiza sytuacji mieszkańców" isExecutable="true">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_SYS" name="System"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>J1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ZAR" name="Zarząd"><bpmn:flowNodeRef>S3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Co 12 godzin"><bpmn:timerEventDefinition id="S1_t"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT12H</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:startEvent id="S3" name="Zgłoszenie zdarzenia"><bpmn:messageEventDefinition id="S3_m" messageRef="Msg_Zgl" /></bpmn:startEvent>
<bpmn:sendTask id="T1" name="Wyślij zapytanie o dane mieszkańców" />
<bpmn:receiveTask id="T2" name="Odbierz dane mieszkańców" messageRef="Msg_Dane" />
<bpmn:businessRuleTask id="T3" name="Wyznacz potrzeby i priorytet mieszkańców (DMN)" />
<bpmn:exclusiveGateway id="G1" name="Są zgłoszenia do weryfikacji?" />
<bpmn:userTask id="T4" name="Zweryfikuj zgłoszenia (śmierć, zaginięcie, choroba)" />
<bpmn:exclusiveGateway id="J1" />
<bpmn:serviceTask id="T5" name="Zapisz wyniki w rejestrze potrzeb" />
<bpmn:endEvent id="E1" name="Analiza zakończona" />
<bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
<bpmn:sequenceFlow id="F13" sourceRef="S3" targetRef="T1" />
<bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
<bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
<bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="G1" />
<bpmn:sequenceFlow id="F5" name="nie" sourceRef="G1" targetRef="J1" />
<bpmn:sequenceFlow id="F6" name="tak" sourceRef="G1" targetRef="T4" />
<bpmn:sequenceFlow id="F7" sourceRef="T4" targetRef="J1" />
<bpmn:sequenceFlow id="F8" sourceRef="J1" targetRef="T5" />
<bpmn:sequenceFlow id="F9" sourceRef="T5" targetRef="E1" />
</bpmn:process>
<bpmn:process id="P1_Zgloszenie" name="Rejestracja zgłoszenia" isExecutable="true">
<bpmn:startEvent id="S2" name="Domownik zgłasza zdarzenie" />
<bpmn:userTask id="T6" name="Zarejestruj zgłoszenie" />
<bpmn:sendTask id="T7" name="Przekaż zgłoszenie do centrum" />
<bpmn:endEvent id="E2" name="Zgłoszenie przekazane" />
<bpmn:sequenceFlow id="F10" sourceRef="S2" targetRef="T6" />
<bpmn:sequenceFlow id="F11" sourceRef="T6" targetRef="T7" />
<bpmn:sequenceFlow id="F12" sourceRef="T7" targetRef="E2" />
</bpmn:process>
<bpmn:message id="Msg_Dane" name="Dane mieszkańców" />
<bpmn:message id="Msg_Zap" name="Zapytanie o dane" />
<bpmn:message id="Msg_Zgl" name="Zgłoszenie zdarzenia" />
