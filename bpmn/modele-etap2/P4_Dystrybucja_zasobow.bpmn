<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="P4_defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">

<bpmn:collaboration id="P4_c">
<bpmn:participant id="C_P3" name="P3 – Przydział zasobów" />
<bpmn:participant id="Pool_MAG" name="Magazyn – Dystrybucja zasobów" processRef="Proces_Dystrybucja" />
<bpmn:participant id="C_P1" name="P1 – Analiza sytuacji mieszkańców (Centrum kryzysowe)" />
<bpmn:messageFlow id="P4_m0" name="Zlecenie wydania" sourceRef="C_P3" targetRef="S1" />
<bpmn:messageFlow id="P4_m1" name="Zgłoszenie zdarzenia (brak odbioru)" sourceRef="T4" targetRef="C_P1" />
</bpmn:collaboration>
<bpmn:process id="Proces_Dystrybucja" name="Dystrybucja zasobów" isExecutable="true">
<bpmn:laneSet id="Proces_Dystrybucja_ls">
<bpmn:lane id="P4_MAG" name="Magazyn"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>J1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="P4_OP" name="Operator punktu"><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Zlecenie wydania"><bpmn:messageEventDefinition id="S1_d" /></bpmn:startEvent>
<bpmn:userTask id="T1" name="Skompletuj zasoby"></bpmn:userTask>
<bpmn:userTask id="T2" name="Przewieź zasoby do punktu wydawania"></bpmn:userTask>
<bpmn:userTask id="T3" name="Wydaj zasoby domownikom (ID budynku, PESEL)"></bpmn:userTask>
<bpmn:exclusiveGateway id="G1" name="Wszystkie zasoby odebrane?"></bpmn:exclusiveGateway>
<bpmn:sendTask id="T4" name="Zgłoś brak odbioru do centrum"></bpmn:sendTask>
<bpmn:exclusiveGateway id="J1" name=""></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T5" name="Zwróć nieodebrane zasoby i wygeneruj raport"></bpmn:serviceTask>
<bpmn:endEvent id="E1" name="Dystrybucja zakończona"></bpmn:endEvent>
<bpmn:sequenceFlow id="S1_T1" name="" sourceRef="S1" targetRef="T1" />
<bpmn:sequenceFlow id="T1_T2" name="" sourceRef="T1" targetRef="T2" />
<bpmn:sequenceFlow id="T2_T3" name="" sourceRef="T2" targetRef="T3" />
<bpmn:sequenceFlow id="T3_G1" name="" sourceRef="T3" targetRef="G1" />
<bpmn:sequenceFlow id="G1_J1" name="tak" sourceRef="G1" targetRef="J1" />
<bpmn:sequenceFlow id="G1_T4" name="nie" sourceRef="G1" targetRef="T4" />
<bpmn:sequenceFlow id="T4_J1" name="" sourceRef="T4" targetRef="J1" />
<bpmn:sequenceFlow id="J1_T5" name="" sourceRef="J1" targetRef="T5" />
<bpmn:sequenceFlow id="T5_E1" name="" sourceRef="T5" targetRef="E1" />
</bpmn:process>
<bpmndi:BPMNDiagram id="P4_d"><bpmndi:BPMNPlane id="P4_p" bpmnElement="P4_c">
<bpmndi:BPMNShape id="C_P3_di" bpmnElement="C_P3" isHorizontal="true"><dc:Bounds x="160" y="40" width="1660" height="60" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Pool_MAG_di" bpmnElement="Pool_MAG" isHorizontal="true"><dc:Bounds x="160" y="180" width="1660" height="300" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="P4_MAG_di" bpmnElement="P4_MAG" isHorizontal="true"><dc:Bounds x="190" y="180" width="1630" height="150" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="P4_OP_di" bpmnElement="P4_OP" isHorizontal="true"><dc:Bounds x="190" y="330" width="1630" height="150" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="C_P1_di" bpmnElement="C_P1" isHorizontal="true"><dc:Bounds x="160" y="560" width="1660" height="60" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="232" y="237" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="360" y="215" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="520" y="215" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="680" y="365" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="865" y="380" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="1000" y="365" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="J1_di" bpmnElement="J1" isMarkerVisible="true"><dc:Bounds x="1185" y="230" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="1320" y="215" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="1512" y="237" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="S1_T1_di" bpmnElement="S1_T1"><di:waypoint x="268" y="255" /><di:waypoint x="360" y="255" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="T1_T2_di" bpmnElement="T1_T2"><di:waypoint x="460" y="255" /><di:waypoint x="520" y="255" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="T2_T3_di" bpmnElement="T2_T3"><di:waypoint x="620" y="255" /><di:waypoint x="650" y="255" /><di:waypoint x="650" y="405" /><di:waypoint x="680" y="405" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="T3_G1_di" bpmnElement="T3_G1"><di:waypoint x="780" y="405" /><di:waypoint x="865" y="405" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="G1_J1_di" bpmnElement="G1_J1"><di:waypoint x="890" y="380" /><di:waypoint x="890" y="255" /><di:waypoint x="1185" y="255" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="G1_T4_di" bpmnElement="G1_T4"><di:waypoint x="915" y="405" /><di:waypoint x="1000" y="405" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="T4_J1_di" bpmnElement="T4_J1"><di:waypoint x="1100" y="405" /><di:waypoint x="1210" y="405" /><di:waypoint x="1210" y="280" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="J1_T5_di" bpmnElement="J1_T5"><di:waypoint x="1235" y="255" /><di:waypoint x="1320" y="255" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="T5_E1_di" bpmnElement="T5_E1"><di:waypoint x="1420" y="255" /><di:waypoint x="1512" y="255" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="P4_m0_di" bpmnElement="P4_m0"><di:waypoint x="250" y="100" /><di:waypoint x="250" y="237" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="P4_m1_di" bpmnElement="P4_m1"><di:waypoint x="1050" y="445" /><di:waypoint x="1050" y="560" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
