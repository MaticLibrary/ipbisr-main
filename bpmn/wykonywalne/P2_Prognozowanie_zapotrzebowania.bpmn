<bpmndi:BPMNEdge id="T2_T3_di" bpmnElement="T2_T3"><di:waypoint x="780" y="345" /><di:waypoint x="840" y="345" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="T3_G1_di" bpmnElement="T3_G1"><di:waypoint x="940" y="345" /><di:waypoint x="1025" y="345" /></bpmndi:BPMNEdge>
