<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="P2_defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">

<bpmn:collaboration id="P2_c">
<bpmn:participant id="Pool_POG" name="System pogodowy" processRef="Proces_Pogoda" />
<bpmn:participant id="Pool_CK2" name="Centrum kryzysowe – Prognozowanie zapotrzebowania" processRef="Proces_Prognozowanie" />
<bpmn:messageFlow id="P2_m0" name="Zapytanie o pogodę" sourceRef="T1" targetRef="W_S" />
<bpmn:messageFlow id="P2_m1" name="Dane pogodowe" sourceRef="W_E" targetRef="T2" />
</bpmn:collaboration>
<bpmn:process id="Proces_Pogoda" name="System pogodowy – udostępnianie prognozy" isExecutable="false">
<bpmn:startEvent id="W_S" name="Otrzymano zapytanie o pogodę"><bpmn:messageEventDefinition id="W_S_d" /></bpmn:startEvent>
<bpmn:serviceTask id="W_T" name="Pobierz prognozę pogody"></bpmn:serviceTask>
<bpmn:endEvent id="W_E" name="Dane pogodowe wysłane"><bpmn:messageEventDefinition id="W_E_d" /></bpmn:endEvent>
<bpmn:sequenceFlow id="W_S_W_T" name="" sourceRef="W_S" targetRef="W_T" />
<bpmn:sequenceFlow id="W_T_W_E" name="" sourceRef="W_T" targetRef="W_E" />
</bpmn:process>
<bpmn:process id="Proces_Prognozowanie" name="Prognozowanie zapotrzebowania" isExecutable="true">
<bpmn:laneSet id="Proces_Prognozowanie_ls">
<bpmn:lane id="P2_SYS" name="System"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>J1</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="P2_ANA" name="Analityk kryzysowy"><bpmn:flowNodeRef>S2</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Co 12 godzin"><bpmn:timerEventDefinition id="S1_d"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT12H</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:startEvent id="S2" name="Zmiana sytuacji kryzysowej"><bpmn:messageEventDefinition id="S2_d" /></bpmn:startEvent>
<bpmn:sendTask id="T1" name="Wyślij zapytanie o dane pogodowe"></bpmn:sendTask>
<bpmn:receiveTask id="T2" name="Odbierz dane pogodowe"></bpmn:receiveTask>
<bpmn:serviceTask id="T3" name="Wykonaj prognozę zapotrzebowania (model ML)"></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G1" name="Różnica względem poprzedniej &gt; 30%?"></bpmn:exclusiveGateway>
<bpmn:userTask id="T4" name="Zweryfikuj prognozę"></bpmn:userTask>
<bpmn:exclusiveGateway id="J1" name=""></bpmn:exclusiveGateway>
<bpmn:endEvent id="E1" name="Prognoza gotowa"><bpmn:messageEventDefinition id="E1_d" /></bpmn:endEvent>
<bpmn:sequenceFlow id="S1_T1" name="" sourceRef="S1" targetRef="T1" />
<bpmn:sequenceFlow id="S2_T1" name="" sourceRef="S2" targetRef="T1" />
<bpmn:sequenceFlow id="T1_T2" name="" sourceRef="T1" targetRef="T2" />
<bpmn:sequenceFlow id="T2_T3" name="" sourceRef="T2" targetRef="T3" />
<bpmn:sequenceFlow id="T3_G1" name="" sourceRef="T3" targetRef="G1" />
<bpmn:sequenceFlow id="G1_J1" name="nie" sourceRef="G1" targetRef="J1" />
<bpmn:sequenceFlow id="G1_T4" name="tak" sourceRef="G1" targetRef="T4" />
<bpmn:sequenceFlow id="T4_J1" name="" sourceRef="T4" targetRef="J1" />
<bpmn:sequenceFlow id="J1_E1" name="" sourceRef="J1" targetRef="E1" />
</bpmn:process>
<bpmndi:BPMNDiagram id="P2_d"><bpmndi:BPMNPlane id="P2_p" bpmnElement="P2_c">
