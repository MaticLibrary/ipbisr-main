{
  "components": [
    { "text": "# Wniosek o pomoc humanitarną\nCentrum kryzysowe prosi o zasoby, których brakuje w planie przydziału. Wpisz, ile organizacja przyznaje, i podaj termin dostawy.", "type": "text", "layout": { "row": "row_0", "columns": null }, "id": "t_naglowek" },
