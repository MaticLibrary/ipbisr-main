<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Analiza_defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
<bpmn:collaboration id="Analiza_collab"><bpmn:participant id="Pool_CK" name="Centrum kryzysowe – Analiza sytuacji mieszkańców" processRef="Proces_Analiza_sytuacji" /></bpmn:collaboration>
<bpmn:process id="Proces_Analiza_sytuacji" name="Analiza sytuacji mieszkańców" isExecutable="true">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_SYS" name="System"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>J1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ZAR" name="Zarząd"><bpmn:flowNodeRef>S3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Co 12 godzin"><bpmn:timerEventDefinition id="S1_t"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT12H</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:startEvent id="S3" name="Zgłoszenie zdarzenia"><bpmn:messageEventDefinition id="S3_m" messageRef="Msg_Zgl" /></bpmn:startEvent>
<bpmn:sendTask id="T1" name="Wyślij zapytanie o dane mieszkańców"><bpmn:extensionElements><zeebe:taskDefinition type="wyslij-zapytanie-o-dane" /></bpmn:extensionElements></bpmn:sendTask>
<bpmn:receiveTask id="T2" name="Odbierz dane mieszkańców" messageRef="Msg_Dane" />
<bpmn:businessRuleTask id="T3" name="Wyznacz potrzeby i priorytet mieszkańców (DMN)"><bpmn:extensionElements><zeebe:calledDecision decisionId="Priorytet_mieszkancow" resultVariable="priorytet" /></bpmn:extensionElements></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="G1" name="Są zgłoszenia do weryfikacji?" default="F5" />
<bpmn:userTask id="T4" name="Zweryfikuj zgłoszenia (śmierć, zaginięcie, choroba)"><bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements></bpmn:userTask>
<bpmn:exclusiveGateway id="J1" />
<bpmn:serviceTask id="T5" name="Zapisz wyniki w rejestrze potrzeb"><bpmn:extensionElements><zeebe:taskDefinition type="zapisz-wyniki" /></bpmn:extensionElements></bpmn:serviceTask>
<bpmn:endEvent id="E1" name="Analiza zakończona" />
<bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
<bpmn:sequenceFlow id="F13" sourceRef="S3" targetRef="T1" />
<bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
<bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
<bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="G1" />
<bpmn:sequenceFlow id="F5" name="nie" sourceRef="G1" targetRef="J1" />
<bpmn:sequenceFlow id="F6" name="tak" sourceRef="G1" targetRef="T4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zgloszeniaDoWeryfikacji = true</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F7" sourceRef="T4" targetRef="J1" />
<bpmn:sequenceFlow id="F8" sourceRef="J1" targetRef="T5" />
<bpmn:sequenceFlow id="F9" sourceRef="T5" targetRef="E1" />
</bpmn:process>
<bpmn:message id="Msg_Zgl" name="Zgłoszenie zdarzenia" />
<bpmn:message id="Msg_Dane" name="Dane mieszkańców"><bpmn:extensionElements><zeebe:subscription correlationKey="=idZapytania" /></bpmn:extensionElements></bpmn:message>
<bpmndi:BPMNDiagram id="D1"><bpmndi:BPMNPlane id="PL1" bpmnElement="Analiza_collab">
<bpmndi:BPMNShape id="Pool_CK_di" bpmnElement="Pool_CK" isHorizontal="true"><dc:Bounds x="160" y="40" width="1300" height="320" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="L_SYS_di" bpmnElement="L_SYS" isHorizontal="true"><dc:Bounds x="190" y="40" width="1270" height="170" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="L_ZAR_di" bpmnElement="L_ZAR" isHorizontal="true"><dc:Bounds x="190" y="210" width="1270" height="150" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="232" y="107" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S3_di" bpmnElement="S3"><dc:Bounds x="362" y="267" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="330" y="85" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="490" y="85" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="650" y="85" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="825" y="100" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="930" y="245" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="J1_di" bpmnElement="J1" isMarkerVisible="true"><dc:Bounds x="1085" y="100" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="1190" y="85" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="1362" y="107" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="268" y="125" /><di:waypoint x="330" y="125" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="380" y="267" /><di:waypoint x="380" y="165" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="430" y="125" /><di:waypoint x="490" y="125" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="590" y="125" /><di:waypoint x="650" y="125" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="750" y="125" /><di:waypoint x="825" y="125" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="875" y="125" /><di:waypoint x="1085" y="125" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="850" y="150" /><di:waypoint x="850" y="285" /><di:waypoint x="930" y="285" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1030" y="285" /><di:waypoint x="1110" y="285" /><di:waypoint x="1110" y="150" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1135" y="125" /><di:waypoint x="1190" y="125" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1290" y="125" /><di:waypoint x="1362" y="125" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
