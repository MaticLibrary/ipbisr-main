<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Przydzial_defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
<bpmn:collaboration id="Przydzial_collab"><bpmn:participant id="Pool_CK3" name="Centrum kryzysowe – (Przydział zasobów)" processRef="Proces_Przydzial" /></bpmn:collaboration>
<bpmn:process id="Proces_Przydzial" name="Przydział zasobów" isExecutable="true">
<bpmn:laneSet id="Proces_Przydzial_ls">
<bpmn:lane id="P3_SYS" name="System"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>J1</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="P3_ANA" name="Analityk kryzysowy"><bpmn:flowNodeRef>S2</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Prognoza gotowa"><bpmn:messageEventDefinition id="S1_d" messageRef="Msg_Prognoza_gotowa" /></bpmn:startEvent>
<bpmn:startEvent id="S2" name="Ponowne planowanie"><bpmn:messageEventDefinition id="S2_d" messageRef="Msg_Ponowne_planowanie" /></bpmn:startEvent>
<bpmn:serviceTask id="T1" name="Pobierz stany magazynowe, potrzeby i prognozy"><bpmn:extensionElements><zeebe:taskDefinition type="pobierz-dane-do-przydzialu" /></bpmn:extensionElements></bpmn:serviceTask>
<bpmn:serviceTask id="T2" name="Wygeneruj plan przydziału (algorytm optymalizacyjny)"><bpmn:extensionElements><zeebe:taskDefinition type="wygeneruj-plan-przydzialu" /></bpmn:extensionElements></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G1" name="Potrzeby krytyczne pokryte?" default="G1_T3" />
<bpmn:sendTask id="T3" name="Wyślij wniosek o pomoc humanitarną"><bpmn:extensionElements><zeebe:taskDefinition type="wyslij-wniosek-o-pomoc" /></bpmn:extensionElements></bpmn:sendTask>
<bpmn:receiveTask id="T4" name="Odbierz odpowiedź na wniosek" messageRef="Msg_Odpowiedz_na_wniosek" />
<bpmn:exclusiveGateway id="J1" name="" />
<bpmn:userTask id="T5" name="Zatwierdź plan przydziału"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="Zatwierdz_plan_przydzialu" /></bpmn:extensionElements></bpmn:userTask>
<bpmn:sendTask id="T6" name="Wyślij zlecenia wydania do magazynu"><bpmn:extensionElements><zeebe:taskDefinition type="wyslij-zlecenia-wydania" /></bpmn:extensionElements></bpmn:sendTask>
<bpmn:endEvent id="E1" name="Plan przekazany" />
<bpmn:sequenceFlow id="S1_T1" name="" sourceRef="S1" targetRef="T1" />
<bpmn:sequenceFlow id="S2_T1" name="" sourceRef="S2" targetRef="T1" />
<bpmn:sequenceFlow id="T1_T2" name="" sourceRef="T1" targetRef="T2" />
<bpmn:sequenceFlow id="T2_G1" name="" sourceRef="T2" targetRef="G1" />
<bpmn:sequenceFlow id="G1_J1" name="tak" sourceRef="G1" targetRef="J1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=potrzebyKrytycznePokryte</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="G1_T3" name="nie" sourceRef="G1" targetRef="T3" />
<bpmn:sequenceFlow id="T3_T4" name="" sourceRef="T3" targetRef="T4" />
<bpmn:sequenceFlow id="T4_J1" name="" sourceRef="T4" targetRef="J1" />
<bpmn:sequenceFlow id="J1_T5" name="" sourceRef="J1" targetRef="T5" />
<bpmn:sequenceFlow id="T5_T6" name="" sourceRef="T5" targetRef="T6" />
<bpmn:sequenceFlow id="T6_E1" name="" sourceRef="T6" targetRef="E1" />
</bpmn:process>
<bpmn:message id="Msg_Prognoza_gotowa" name="Prognoza gotowa" />
<bpmn:message id="Msg_Ponowne_planowanie" name="Ponowne planowanie" />
<bpmn:message id="Msg_Odpowiedz_na_wniosek" name="Odpowiedź na wniosek"><bpmn:extensionElements><zeebe:subscription correlationKey="=idWniosku" /></bpmn:extensionElements></bpmn:message>
<bpmndi:BPMNDiagram id="P3_d"><bpmndi:BPMNPlane id="P3_p" bpmnElement="Przydzial_collab">
